{
  "name": "collegehoopshub-server",
  "version": "1.0.0",
  "description": "API server for CollegeHoopsHub (scores, teams, players, stats, news)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "sync:espn": "tsx src/sync-espn.ts",
    "sync:scoreboard": "tsx src/sync-scoreboard.ts",
    "test:espn-mappers": "tsx src/providers/espn/__fixtures__/run.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
