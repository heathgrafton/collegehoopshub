generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite for local/dev simplicity. Swap to "postgresql" + a DATABASE_URL
  // for production (schema is already Postgres-compatible).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Conference {
  id        String   @id @default(cuid())
  espnId    String?  @unique // ESPN "group" id, when sourced from ESPN
  name      String   @unique
  shortName String
  teams     Team[]
}

model Team {
  id            String       @id @default(cuid())
  espnId        String?      @unique // ESPN team id, when sourced from ESPN
  cbbdId        String?      @unique // CollegeBasketballData.com team id, once matched
  name          String
  shortName     String
  nickname      String
  city          String
  state         String
  venueName     String?
  primaryColor  String
  logoUrl       String?
  latitude      Float?
  longitude     Float?
  conferenceId  String
  conference    Conference   @relation(fields: [conferenceId], references: [id])
  players       Player[]
  homeGames     Game[]       @relation("HomeTeam")
  awayGames     Game[]       @relation("AwayTeam")
  seasonStats   TeamSeasonStat[]
  newsArticles  NewsArticle[]
  favorites     Favorite[]
  incomingMoves PlayerMove[] @relation("DestinationTeam")
  outgoingMoves PlayerMove[] @relation("OriginTeam")

  @@index([conferenceId])
}

model Player {
  id            String   @id @default(cuid())
  espnId        String?  @unique // ESPN athlete id, when sourced from ESPN
  cbbdId        String?  @unique // CollegeBasketballData.com athlete id, once matched
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id])
  firstName     String
  lastName      String
  jerseyNumber  String
  position      String
  heightInches  Int
  classYear     String // Fr, So, Jr, Sr, Gr
  hometown      String
  photoUrl      String?
  seasonStats   PlayerSeasonStat[]
  chatMessages  ChatMessage[]
  favorites     Favorite[]

  @@index([teamId])
}

model Game {
  id           String    @id @default(cuid())
  espnId       String?   @unique // ESPN event id, when sourced from ESPN
  season       Int
  startTime    DateTime
  status       String    // "scheduled" | "live" | "final"
  period       Int       @default(0)
  clock        String    @default("")
  homeTeamId   String
  awayTeamId   String
  homeTeam     Team      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int       @default(0)
  awayScore    Int       @default(0)
  venue        String
  broadcast    String?
  chatMessages ChatMessage[]

  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status])
}

model PlayerSeasonStat {
  id           String  @id @default(cuid())
  playerId     String
  player       Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season       Int
  gamesPlayed  Int
  pointsPerGame     Float
  reboundsPerGame   Float
  assistsPerGame    Float
  stealsPerGame     Float
  blocksPerGame     Float
  minutesPerGame    Float
  fieldGoalPct      Float
  threePointPct     Float
  freeThrowPct      Float
  // Advanced stats, from CBBD's season totals divided by games played.
  turnoversPerGame        Float?
  foulsPerGame            Float?
  offensiveReboundsPerGame Float?
  defensiveReboundsPerGame Float?
  fieldGoalsMade          Float?
  fieldGoalsAttempted     Float?
  threePointMade          Float?
  threePointAttempted     Float?
  freeThrowsMade          Float?
  freeThrowsAttempted     Float?
  usage                   Float?
  offensiveRating         Float?
  defensiveRating         Float?
  netRating               Float?
  effectiveFieldGoalPct   Float?
  trueShootingPct         Float?
  winShares               Float?

  @@unique([playerId, season])
}

model TeamSeasonStat {
  id                String @id @default(cuid())
  teamId            String
  team              Team   @relation(fields: [teamId], references: [id])
  season            Int
  wins              Int
  losses            Int
  conferenceWins    Int
  conferenceLosses  Int
  // Advanced per-game stats aren't in ESPN's standings response (the only
  // source wired up so far) — nullable until a stats-specific sync exists.
  pointsPerGame     Float?
  opponentPointsPerGame Float?
  reboundsPerGame   Float?
  assistsPerGame    Float?
  netRating         Float?
  strengthOfSchedule Float?
  pace                  Float?
  effectiveFieldGoalPct Float?
  turnoversPerGame      Float?

  @@unique([teamId, season])
}

model NewsArticle {
  id          String   @id @default(cuid())
  espnId      String?  @unique // ESPN article id, when sourced from ESPN
  title       String
  summary     String
  body        String
  source      String
  publishedAt DateTime
  imageUrl    String?
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id])

  @@index([teamId])
  @@index([publishedAt])
}

// Transfer-portal moves and recruiting commitments from CollegeBasketballData.com.
// Their API has no per-move timestamp, only a season `year`, so `syncedAt` (when
// our own sync first saw the row) is the closest thing to a "recency" signal.
model PlayerMove {
  id                    String   @id @default(cuid())
  cbbdId                String   @unique // "transfer-<id>" or "commitment-<id>"
  type                  String   // "transfer" | "commitment"
  year                  Int
  playerName            String
  position              String?
  stars                 Int?
  rating                Float?
  originName            String?
  originConference      String?
  destinationName       String?
  destinationConference String?
  destinationTeamId     String?
  destinationTeam       Team?    @relation("DestinationTeam", fields: [destinationTeamId], references: [id])
  originTeamId          String?
  originTeam            Team?    @relation("OriginTeam", fields: [originTeamId], references: [id])
  syncedAt              DateTime @default(now())

  @@index([type])
  @@index([year])
  @@index([syncedAt])
}

// --- Roadmap models (schema in place now; not yet wired to the mobile UI) ---

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName String
  createdAt   DateTime   @default(now())
  favorites   Favorite[]
  chatMessages ChatMessage[]
}

model Favorite {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  teamId       String?
  team         Team?   @relation(fields: [teamId], references: [id])
  playerId     String?
  player       Player? @relation(fields: [playerId], references: [id], onDelete: Cascade)
  conferenceName String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  gameId    String?
  game      Game?    @relation(fields: [gameId], references: [id])
  playerId  String?
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([gameId])
  @@index([playerId])
}
